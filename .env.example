# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commitar o arquivo .env.
# ============================================================

# --- Geral ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
# Lido pelo frontend em BUILD time (Next.js embute NEXT_PUBLIC_* no bundle,
# não lê em runtime) — em produção precisa ser a URL pública da API (ex.:
# https://api.seudominio.com), passada como build arg no docker-compose.yml.
# Em dev local, o padrão (http://localhost:3001) já funciona sem precisar setar.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Deploy em produção (Traefik + Let's Encrypt, ver docker-compose.yml,
# profile "production") — sem efeito em dev local (`docker compose up` sem
# `--profile production` nunca sobe o Traefik). Os domínios precisam já
# apontar (DNS A/AAAA) para o IP da VPS antes do primeiro `docker compose
# --profile production up -d`, senão o desafio HTTP-01 do Let's Encrypt falha. ---
APP_DOMAIN=app.seudominio.com
API_DOMAIN=api.seudominio.com
ACME_EMAIL=
# Domínio-pai compartilhado por APP_DOMAIN e API_DOMAIN, para os cookies de
# sessão (JWT) ficarem visíveis nos dois — sem isso, o cookie fica preso ao
# host exato que o criou (a API) e o middleware.ts do painel nunca o vê.
# Deixe em branco em dev local (localhost cobre portas diferentes sozinho).
# Exemplo: se APP_DOMAIN=app.seudominio.com e API_DOMAIN=api.seudominio.com,
# use COOKIE_DOMAIN=seudominio.com (cobre os dois subdomínios).
COOKIE_DOMAIN=

# "true" (padrão) exige confirmar por código de 6 dígitos ao trocar o
# e-mail da empresa (Tenant.email, em Meus Dados) antes de aplicar a troca;
# "false" aplica na hora, sem código. Documento de alterações, item 6.1.7.3.
EMAIL_CONFIRMATION_REQUIRED=true

# --- Traefik compartilhado com outro projeto na mesma VPS (opcional) ---
# Sem efeito se você usar docker-compose.traefik-standalone.yml (Traefik
# próprio deste projeto). Necessário só com docker-compose.traefik-shared.yml
# — ver comentários nesse arquivo e a seção 3 do DEPLOY.md.
TRAEFIK_CERTRESOLVER=le
# Rede pequena e exclusiva deste projeto, criada por nós — NÃO é a rede do
# outro projeto (ver aviso em docker-compose.traefik-shared.yml sobre por
# que não reaproveitar a rede inteira do outro projeto).
TRAEFIK_BRIDGE_NETWORK=chatbot-saas-platform_traefik-bridge

# --- Banco de dados (PostgreSQL) ---
# Porta de host 5434 (não 5432) para não conflitar com outros projetos locais
# que já usam a porta padrão — ver docker-compose.yml. Publicada só em
# 127.0.0.1 (não acessível de fora do host, nem em produção).
# POSTGRES_PASSWORD: senha do papel "postgres" usado pelo container — troque
# em produção (o padrão "postgres" é só para dev local).
POSTGRES_PASSWORD=postgres
# DATABASE_URL: papel "postgres" (dono das tabelas) — só para Prisma Migrate.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/chatbot_saas?schema=public
# DATABASE_RUNTIME_URL: papel restrito "app_runtime" (criado pela migration
# de Row-Level Security, Fase 19) — sujeito às políticas de RLS. Ainda não é
# usado pelo PrismaService em runtime (ver nota no fim da migration.sql);
# fica pronto para quando o wrapping de SET LOCAL app.tenant_id for feito.
DATABASE_RUNTIME_URL=postgresql://app_runtime:CHANGE_ME@localhost:5434/chatbot_saas?schema=public

# --- Redis / Filas ---
REDIS_URL=redis://localhost:6381

# --- Storage S3-compatible (MinIO em dev; em produção pode apontar para um
# bucket S3/MinIO externo de verdade, trocando S3_ENDPOINT) ---
S3_ENDPOINT=http://localhost:9004
S3_REGION=us-east-1
S3_BUCKET=chatbot-saas-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Credenciais do container MinIO (docker-compose.yml) — troque em produção,
# "minioadmin"/"minioadmin" é só o padrão de dev local.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Autenticação ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Seed inicial do Painel Master ---
MASTER_SEED_EMAIL=
MASTER_SEED_PASSWORD=

# --- WhatsApp — API oficial (Meta) ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_API_VERSION=v20.0

# --- WhatsApp — conexão não oficial ---
# Ponte real via @whiskeysockets/baileys (protocolo multi-device do WhatsApp
# Web) por padrão — QR Code real, sessão persistida em disco. Troque para
# "fake_unofficial" para usar o simulador em memória (dev/CI sem telefone
# real disponível para escanear o QR).
WHATSAPP_UNOFFICIAL_PROVIDER=baileys_unofficial
# Diretório (relativo à raiz de apps/api) onde as credenciais de sessão de
# cada número ficam salvas — cada subpasta é nomeada pelo id do WhatsAppNumber.
WHATSAPP_SESSIONS_DIR=.baileys-sessions

# --- IA (chaves da plataforma — usadas quando o Master libera "chave da
# plataforma" para um tenant via FeatureFlag "ia"; a chave própria de cada
# tenant, quando permitida, fica cadastrada por eles mesmos, criptografada
# no banco — ver ENCRYPTION_KEY abaixo e TenantAiCredential) ---
AI_PLATFORM_ANTHROPIC_API_KEY=
AI_PLATFORM_OPENAI_API_KEY=
AI_PLATFORM_GOOGLE_API_KEY=

# --- Criptografia de segredos (chave própria de IA cadastrada pelo tenant) ---
# 32 bytes em base64 — gerar com: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Gateway de pagamento (adaptador) ---
# "fake" (padrão, simulador de dev/teste) ou "stripe" (real, exige as duas chaves abaixo)
PAYMENT_GATEWAY_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observabilidade ---
LOG_LEVEL=info
